<title>Niranjan Portfolio</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Georgia", serif;
}

html{
    scroll-behavior:smooth;
}


body{

    background:#ece6db;
    color:#333;

}


/* Header */

header{

    background:#1c1c1c;
    color:white;

    padding:20px 8%;

    display:flex;
    justify-content:space-between;
    align-items:center;

}


.logo{

    font-size:30px;
    font-weight:bold;
    color:#37bcd4;

}


nav a{

    color:white;
    text-decoration:none;
    margin-left:25px;
    transition:.3s;

}


nav a:hover{

    color:#d4af37;

}



/* Hero */


.hero{

    height:90vh;

    display:flex;
    align-items:center;
    justify-content:center;

    text-align:center;

}


.profile{

    width:160px;
    height:160px;

    border-radius:50%;

    background:#d4af37;

    color:white;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:70px;

    margin:auto;

    animation:zoom 1.5s;

}



@keyframes zoom{

from{

transform:scale(0);

opacity:0;

}

to{

transform:scale(1);

opacity:1;

}

}



h1{

    font-size:50px;

    margin-top:20px;

    color:#1c1c1c;

}



.hero p{

    font-size:22px;

    margin-top:15px;

    color:#555;

}



/* Buttons */


.btn{

    display:inline-block;

    margin-top:25px;

    padding:12px 35px;

    background:#1c1c1c;

    color:white;

    text-decoration:none;

    border-radius:30px;

    transition:.4s;

}


.btn:hover{

    background:#d4af37;

    transform:translateY(-5px);

}



.photo-btn{

    margin-left:15px;

    background:#d4af37;

}



.photo-btn:hover{

    background:#1c1c1c;

    color:#d4af37;

}



/* Sections */


section{

    width:80%;

    margin:50px auto;

    padding:35px;

    background:white;

    box-shadow:0 10px 30px rgba(0,0,0,.1);

    border-radius:10px;

    animation:slide 1s;

}



@keyframes slide{

from{

opacity:0;

transform:translateY(50px);

}

to{

opacity:1;

}

}



h2{

    color:#b8860b;

    margin-bottom:20px;

    font-size:30px;

}



/* Skills */


.skills span{

    display:inline-block;

    padding:10px 20px;

    margin:8px;

    background:#f0e6c8;

    border-radius:20px;

}



/* Projects */


.project{

    padding:15px;

    margin:15px 0;

    border-left:4px solid #d4af37;

}



/* Footer */


footer{

    background:#1c1c1c;

    color:white;

    text-align:center;

    padding:20px;

}


</style>

</head>


